# Copy to .env and adjust — never commit real secrets
# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_de_clone
REDIS_URL=redis://:autovia_redis_dev@127.0.0.1:6380
ELASTICSEARCH_NODE=http://127.0.0.1:9200
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-32plus-char-secret-value!!
REINDEX_SECRET=replace-with-a-long-reindex-secret
PORT=4000
# Bind localhost only by default (ops hardening)
HOST=127.0.0.1
# Optional comma-separated CORS origins (web :3000, admin :3001)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# MinIO (S3-compatible image storage) — must match docker-compose
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=autovia
MINIO_SECRET_KEY=autovia_minio_local_dev_only
MINIO_BUCKET=autovia-vehicles
MINIO_REGION=us-east-1
