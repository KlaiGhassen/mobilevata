# ============================================================
# Autovia production environment
# Copy to the repo root as `.env` (Compose reads it from there).
# `deploy/setup-server.sh` does this automatically with a
# detected public IP and freshly generated secrets.
# ============================================================

# Public IP (or hostname) of your server. Used by the browser to
# reach the API (port 4000) and MinIO image URLs (port 9000).
SERVER_IP=YOUR_SERVER_PUBLIC_IP

# Required — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
REINDEX_SECRET=CHANGE_ME

# Redis — generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME

# MinIO root credentials (used by MinIO server and the API S3 client)
MINIO_ROOT_USER=autovia
MINIO_ROOT_PASSWORD=CHANGE_ME